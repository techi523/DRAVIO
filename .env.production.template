# ═══════════════════════════════════════════════════════════════════
# DRAVIO Platform — Environment Configuration (Railway Production)
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in production values.
# NEVER commit the .env file to version control.
# Set all variables in Railway Dashboard → Service → Variables.

# ─── Database ─────────────────────────────────────────────────────
# Auto-injected by Railway Postgres plugin, or set manually:
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://dravio_user:CHANGE_ME@CHANGE_ME.railway.internal:5432/dravio_production

# ─── MongoDB (if used) ───────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ─── JWT Authentication ─────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND

# ─── Firebase Admin SDK ─────────────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
# Download the JSON, then extract these three fields:
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@CHANGE_ME.iam.gserviceaccount.com
# Paste the private key exactly as it appears in the JSON (with \n line breaks):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary ─────────────────────────────────────────────────
# From https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ─── Payment Providers ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CHECKOUT_BASE_URL=https://checkout.dravio.com

# ─── M-Pesa / Safaricom Daraja API ─────────────────────────────
MPESA_ENV=production
MPESA_CONSUMER_KEY=CHANGE_ME
MPESA_CONSUMER_SECRET=CHANGE_ME
MPESA_PASSKEY=CHANGE_ME
MPESA_SHORTCODE=CHANGE_ME
MPESA_CALLBACK_URL=https://<your-service>.railway.app/v1/payments/mpesa/callback

# ─── Currency ────────────────────────────────────────────────────
USD_TO_KES_RATE=155.0

# ─── CORS (comma-separated allowed origins) ────────────────────
# Include your Vercel deployment URLs:
CORS_ORIGINS=https://buyer-web-henna.vercel.app,https://admin-portal-weld-seven.vercel.app

# ─── VPN Infrastructure ────────────────────────────────────────
RELAY_CONFIG_URL=
RELAY_CONFIG_FILE=

# ─── Kafka ──────────────────────────────────────────────────────
KAFKA_URL=kafka:9092

# ─── Redis (Upstash) ────────────────────────────────────────────
# Upstash TLS connection string — from https://console.upstash.com
# Format: rediss://default:<password>@<hostname>.upstash.io:6379
# NOTE: Use rediss:// (with double-s) for TLS — required by Upstash
REDIS_URL=rediss://default:CHANGE_ME@CHANGE_ME.upstash.io:6379

# ─── Service Internal URLs (co-located in Railway container) ─────
AUTH_SERVICE_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3002
MARKETPLACE_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3005
ADMIN_SERVICE_URL=http://localhost:3008

# ─── Twilio (OTP) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_VERIFY_SERVICE_SID=CHANGE_ME

# ─── OAuth ─────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID is no longer needed on the backend — Firebase Admin SDK
# verifies Google ID tokens without requiring the client ID.
# It is still needed in the FRONTEND (buyer-web Vercel env vars):
# NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
# NEXT_PUBLIC_FIREBASE_PROJECT_ID
GOOGLE_CLIENT_ID=CHANGE_ME_OR_REMOVE_IF_ONLY_USING_FIREBASE
APPLE_CLIENT_ID=CHANGE_ME
