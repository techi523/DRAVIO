{
  "name": "@dravio/billing-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx --no-install jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "npx --no-install jest --config jest.config.cjs --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": false,
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@dravio/auth-middleware": "file:../../packages/auth-middleware",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "fastify": "^4.26.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "redis": "^5.11.0",
    "uuid": "^7.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
