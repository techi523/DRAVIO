{
  "name": "mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:offline": "expo start --offline",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean": "npx expo start --clear & exit 0",
    "clean:cache": "rimraf .expo node_modules/.cache && echo Cache cleared",
    "adb:devices": "adb devices -l",
    "adb:wifi": "adb tcpip 5555 && echo Now disconnect USB and run: adb connect DEVICE_IP:5555",
    "adb:logcat": "adb logcat *:E ReactNative:V ReactNativeJS:V",
    "doctor": "npx expo-doctor@latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~55.0.24",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "0.21.2",
    "react-native-wireguard-vpn": "^1.0.22",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.2",
    "@types/react-native-get-random-values": "^1.8.2",
    "expo-build-properties": "^55.0.14",
    "typescript": "~5.9.2"
  },
  "private": true
}
